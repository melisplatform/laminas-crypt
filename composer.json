{
    "name": "melisplatform/laminas-crypt",
    "description": "Melis Platform fork of laminas/laminas-crypt - adds PHP 8.4 / 8.5 support. Strong cryptography tools and password hashing",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "crypt",
        "melis",
        "melisplatform"
    ],
    "homepage": "https://www.melistechnology.com",
    "replace": {
        "laminas/laminas-crypt": "self.version"
    },
    "support": {
        "docs": "https://docs.laminas.dev/laminas-crypt/",
        "issues": "https://github.com/melisplatform/laminas-crypt/issues",
        "source": "https://github.com/melisplatform/laminas-crypt"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.99"
        }
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-mbstring": "*",
        "laminas/laminas-math": "^3.4",
        "laminas/laminas-stdlib": "^3.8",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "~2.5.0",
        "phpunit/phpunit": "^10.1"
    },
    "suggest": {
        "ext-openssl": "Required for most features of Laminas\\Crypt"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\Crypt\\": "src/"
        }
    },
    "autoload-dev": {
        "files": [
            "test/_autoload.php"
        ],
        "psr-4": {
            "LaminasTest\\Crypt\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "conflict": {
        "zendframework/zend-crypt": "*"
    }
}
